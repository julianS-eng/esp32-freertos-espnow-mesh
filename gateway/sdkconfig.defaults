# --- Target: ESP32-S3 N16R8 (16 MB quad flash, 8 MB octal PSRAM) -----------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot anyway if PSRAM is missing (N16 variants, QEMU); code falls back to internal RAM.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- FreeRTOS -------------------------------------------------------------
# 1 kHz tick: 1 ms resolution for ACK and CONFIG retry timeouts.
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# --- Watchdogs -------------------------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_INT_WDT=y

# --- Robustness / diagnostics ---------------------------------------------
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# --- Wi-Fi / ESP-NOW ------------------------------------------------------
# Up to 17 encrypted peers (the node needs 1, the gateway one per node).
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=17
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_NVS_ENABLED=n

# --- Logging ---------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Gateway specifics --------------------------------------------------------
# 921600 baud: a 17-channel data line averages 486 B (measured in simulation):
# ~190 lines/s here versus ~24 lines/s at 115200 baud.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# xQueueCreateWithCaps() places the output queue in PSRAM.
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
