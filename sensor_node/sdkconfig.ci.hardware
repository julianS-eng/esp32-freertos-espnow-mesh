# CI variant: every real driver enabled + ESP-NOW encryption, to make sure
# all code paths compile. Used as an extra SDKCONFIG_DEFAULTS layer.
CONFIG_SENSOR_MODE_HARDWARE=y
CONFIG_SENSOR_MQ2_ENABLE=y
CONFIG_SENSOR_MOTOR_ENABLE=y
CONFIG_SENSOR_MPU6050_ENABLE=y
CONFIG_MESH_ENCRYPTION=y
CONFIG_NODE_GATEWAY_MAC="24:0a:c4:00:00:01"
CONFIG_MESH_LONG_RANGE=y
